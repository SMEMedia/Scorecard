{
  "auth_mode": "oauth",
  "oauth": {
    "client_secret_file": "config/secrets/google_oauth_client_secret.json",
    "token_file": "config/state/youtube_oauth_token.json"
  },
  "service_account_file": "config/secrets/google_service_account.json",
  "default_date_range": {
    "mode": "latest_completed_week",
    "week_ending_weekday": 5
  },
  "reports": [
    {
      "name": "weekly_channel_video_plays",
      "enabled": true,
      "type": "analytics",
      "ids": "channel==MINE",
      "metrics": [
        "views"
      ],
      "sheet": "SME Media Data",
      "date_column": "Week Ending",
      "date_grain": "week",
      "scorecard_metrics": [
        {
          "api_metric": "views",
          "scorecard_column": "YouTube Video Plays"
        }
      ]
    },
    {
      "name": "weekly_podcast_plays",
      "enabled": true,
      "type": "analytics",
      "ids": "channel==MINE",
      "playlist_id": "PLEMmsgg0GMzCJZnBjaIyMBUPVx9hT0Ft0",
      "metrics": [
        "views"
      ],
      "sheet": "SME Media Data",
      "date_column": "Week Ending",
      "date_grain": "week",
      "scorecard_metrics": [
        {
          "api_metric": "views",
          "scorecard_column": "YouTube Podcast Plays"
        }
      ]
    }
  ]
}

{
  "private_app_token_file": "config/secrets/hubspot_private_app_token.txt",
  "default_date_range": {
    "mode": "latest_completed_week",
    "week_ending_weekday": 5
  },
  "reports": [
    {
      "name": "weekly_email_metrics",
      "description": "Weekly SME Media Data columns Y-AD for HubSpot email metrics.",
      "enabled": true,
      "sheet": "SME Media Data",
      "date_column": "Week Ending",
      "date_grain": "week",
      "columns": {
        "delivered": "Emails Delivered",
        "opens": "Email Opens",
        "open_rate": "Email Open Rate",
        "clicks": "Email Clicks",
        "click_rate": "Email CTR",
        "click_to_open_rate": "Email Click to Open Rate"
      },
      "histogram": {
        "endpoint": "/marketing/emails/2026-03/statistics/histogram",
        "interval": "WEEK",
        "counter_map": {
          "delivered": "Emails Delivered"
        },
        "ratio_map": {
          "openratio": "Email Open Rate",
          "clickratio": "Email CTR",
          "clicktoopenratio": "Email Click to Open Rate"
        }
      },
      "email_folder": {
        "folder_name_template": "{month_name} {year}",
        "exclude_name_contains": [
          "(Clone)"
        ],
        "only_sent": true,
        "date_must_match_report_range": true,
        "counter_map": {
          "delivered": "Emails Delivered"
        },
        "event_map": {
          "OPEN": "Email Opens",
          "CLICK": "Email Clicks"
        }
      }
    }
  ]
}

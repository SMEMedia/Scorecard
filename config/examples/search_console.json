{
  "service_account_file": "C:\\Path\\To\\service-account.json",
  "site_url": "sc-domain:example.com",
  "default_date_range": {
    "mode": "latest_completed_month"
  },
  "monthly": {
    "enabled": true,
    "sheet": "SME Media Data",
    "date_column": "Month",
    "date_grain": "month",

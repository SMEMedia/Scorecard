      "impressions": "Google Search Console Search Impressions",
      "position": "Ave Search Position",
      "ctr": "Search CTR"
    }
  },
  "weekly": {
    "enabled": true,
    "week_ending_weekday": 5,
    "sheet": "SME Media Data",
    "date_column": "Week Ending",
    "date_grain": "week",
    "columns": {
      "clicks": "Google Search Console Search Clicks",
      "impressions": "Google Search Console Search Impressions",
      "position": "Ave Search Position",
      "ctr": "Search CTR"
    }
  }
}
